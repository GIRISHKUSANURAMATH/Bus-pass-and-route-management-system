# ---------------------------------------------------------------
# Copy this file to `.env` and edit. NEVER commit `.env` to git.
# ---------------------------------------------------------------
APP_NAME="SKSVMACET Bus Pass & Route Management"
APP_COLLEGE=SKSVMACET
# development | production
APP_ENV=development
# true shows technical error details - keep false on any shared/deployed server
APP_DEBUG=false
# Absolute URL of the /public folder. Used inside bus-pass QR codes, so a PHONE must be able to open it.
# Local PC only:      http://localhost/SKSVMACET-Bus-Pass-Management/public
# Phones on same WiFi: http://192.168.1.10/SKSVMACET-Bus-Pass-Management/public   (your PC's LAN IP)
APP_URL=http://localhost/SKSVMACET-Bus-Pass-Management/public
APP_TIMEZONE=Asia/Kolkata

# XAMPP defaults: user root with an empty password. Create a dedicated MySQL user for anything beyond your own laptop.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sksvmacet_buspass
DB_USER=root
DB_PASS=

SESSION_NAME=SKSVM_SESSID
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# true = redirect every request to HTTPS (enable once a certificate is installed)
FORCE_HTTPS=false
